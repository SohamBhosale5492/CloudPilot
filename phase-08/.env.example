# Copy to an untracked local .env only when developing locally. Replace every
# placeholder with values supplied by the operator; never commit real values.

# Restricted application connection. The API process receives this URL.
DATABASE_URL=postgresql://cloudpilot_runtime:REPLACE_WITH_LOCAL_RUNTIME_PASSWORD@127.0.0.1:5432/cloudpilot_dev?schema=public

# Single-tenant Microsoft Entra v2 API authentication.
OIDC_TENANT_ID=REPLACE_WITH_TENANT_GUID
OIDC_ISSUER=https://login.microsoftonline.com/REPLACE_WITH_TENANT_GUID/v2.0
OIDC_AUDIENCE=REPLACE_WITH_API_APPLICATION_GUID
OIDC_ALLOWED_CLIENT_IDS=REPLACE_WITH_ALLOWED_CLIENT_APPLICATION_GUID
# Optional; when omitted, provider metadata is discovered from OIDC_ISSUER.
# OIDC_JWKS_URI=https://login.microsoftonline.com/REPLACE_WITH_TENANT_GUID/discovery/v2.0/keys

# Execution stays disabled. Setting true is rejected by the current host guard.
CLOUDPILOT_ENABLE_REMEDIATION_WORKER=false
