{
  "name": "cloudpilot-phase-07-remediation",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo:observability": "npm run build && node dist/phase-07/src/demo-observability.js",
    "demo:secure-alumni": "npm run build && node dist/phase-07/src/demo-secure-alumni.js",
    "test:unit": "npm run build && node --test \"dist/phase-07/test/unit/*.test.js\"",
    "test:integration": "npm run build && node --test \"dist/phase-07/test/integration/*.test.js\"",
    "test": "npm run build && node --test \"dist/phase-07/test/unit/*.test.js\" && node --test \"dist/phase-07/test/integration/*.test.js\""
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.13.14",
    "prisma": "5.22.0",
    "typescript": "5.9.3"
  },
  "prisma": {
    "schema": "../phase-08/prisma/schema.prisma"
  }
}
