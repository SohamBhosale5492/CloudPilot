{
  "name": "cloudpilot-phase-06-api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "test:unit": "npm run build && node --test \"dist/phase-06/test/unit/*.test.js\"",
    "test:integration": "npm run build && node --test \"dist/phase-06/test/integration/*.test.js\"",
    "test": "npm run build && node --test \"dist/phase-06/test/unit/*.test.js\" && node --test \"dist/phase-06/test/integration/*.test.js\""
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@types/node": "22.13.14",
    "prisma": "^5.22.0",
    "typescript": "5.9.3"
  }
}
